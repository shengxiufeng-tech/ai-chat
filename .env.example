# 复制为 .env 后按需修改（也可以直接在网页里的「设置」中修改，网页设置优先）

# OpenAI 兼容接口地址。Magpie 本地网关默认是 http://127.0.0.1:3425/v1
# 填 mock 可以在没有模型的情况下用模拟回复体验界面
LLM_BASE_URL=http://127.0.0.1:3425/v1

# 本机调用 Magpie 时任意 key 都可以；magpie-ai-chat 会让 Magpie 的用量统计里显示为 ai-chat
LLM_API_KEY=magpie-ai-chat

# 后端端口
PORT=8787

# 数据保存目录（房间、角色模板、设置都存成 JSON 文件）
DATA_DIR=./data
